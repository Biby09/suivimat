# Bloque tout accès HTTP direct à ce dossier.
# Les fichiers restent utilisables par PHP via include/require.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (compatibilité)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Désactive le listing du dossier
Options -Indexes
